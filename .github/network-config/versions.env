# versions.env — NEMTUS image versions injected into shoestring.ini [images]
#
# Owned by the nemtus mirror layer. apply-nemtus-networks-patch.sh sources this file
# and rewrites the [images] client/rest entries of shoestring.ini (on every branch)
# to point at the NEMTUS ghcr.io images at THESE versions.
#
# IMPORTANT: only bump a version here AFTER the matching image has actually been
# published to ghcr.io/nemtus (see nemtus/symbol catapult-image-* / rest-image-* tags).
# Pinning a version that does not exist would make `docker compose pull` fail downstream.
#
# Upstream mapping (for reference):
#   symbolplatform/symbol-server:gcc-<X>  -> ghcr.io/nemtus/catapult-server:v<X>
#   symbolplatform/symbol-rest:<Y>        -> ghcr.io/nemtus/symbol-rest:v<Y>
#   mongo:<Z>                             -> kept as-is (third-party)
CATAPULT_IMAGE_VERSION=v1.0.3.9
REST_IMAGE_VERSION=v2.5.1
